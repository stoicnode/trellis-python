        "recordKind",
        "id",
        "eventId",
        "snapshotSide",
        "scope",
        "run",
        "platform",
        "sourceSha256",
        "analyzerCommit",
        "tools",
        "parserIdentity",
        "graphPolicyIdentity",
        "clonePolicyIdentity",
        "metrics",
        "coverage",
        "rawReport",
        "sourceUnchanged",
        "semanticSha256",
        "elapsedMs",
