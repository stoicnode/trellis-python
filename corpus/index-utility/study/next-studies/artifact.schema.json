        "sharedClusterIds"
      ]
    },
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "recordKind": {
          "const": "packet"
        },
        "id": {
          "type": "string",
