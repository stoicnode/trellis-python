    "prediction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "recordKind": {
          "const": "prediction"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "blockOrEventId": {
          "type": "string",
          "minLength": 1
        },
        "study": {
          "enum": [
            "C1",
            "N1",
            "D1",
            "G1",
            "A1"
          ]
        },
