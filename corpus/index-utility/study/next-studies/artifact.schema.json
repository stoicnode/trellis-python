            "mixed"
          ]
        },
        "sizeStratum": {
          "enum": [
            "le5000",
            "5001to10000",
            "gt10000"
          ]
        },
        "split": {
          "enum": [
            "development",
            "validation",
            "reserve"
          ]
        },
        "before": {
          "$ref": "#/definitions/snapshot"
        },
        "after": {
          "$ref": "#/definitions/snapshot"
        },
        "labelRef": {
          "$ref": "#/definitions/artifactRef"
        },
        "targetBefore": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/range"
          }
        },
        "targetAfter": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/range"
          }
        },
        "scopeMap": {
          "$ref": "#/definitions/artifactRef"
        },
        "packetBefore": {
          "$ref": "#/definitions/artifactRef"
        },
        "packetAfter": {
          "$ref": "#/definitions/artifactRef"
        },
        "eligibility": {
          "enum": [
            "selected",
            "excluded",
            "incomplete"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schemaVersion",
        "recordKind",
        "id",
        "study",
        "lane",
        "repositoryGroup",
        "duplicateComponent",
        "pullRequestGroup",
        "familyGroups",
        "language",
        "syntaxSubtype",
        "sourceRole",
        "sizeStratum",
        "split",
        "before",
        "after",
        "labelRef",
        "targetBefore",
        "targetAfter",
        "scopeMap",
        "packetBefore",
        "packetAfter",
        "eligibility",
        "reason"
      ]
    },
